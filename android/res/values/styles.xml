<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand">#26333D</color>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#D16B27</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/brand</item>
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:navigationBarColor">@color/brand</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
